#!/usr/bin/env bash
#
# This base script is MIT licensed so you can base your
# own work on it.
#
# k8s-get-certificate - extract the CA cert from a k8s cluster
#
# Copyright 2025, Joe Block <jpb@unixorn.net>

set -o pipefail
if [[ -n "$DEBUG" ]]; then
  # shellcheck disable=SC2086
  if [[ "$(echo $DEBUG | tr '[:upper:]' '[:lower:]')" == "verbose" ]]; then
    set -x
  fi
fi

function echo-stderr() {
  printf '%s
' "$1" >&2  ## Send message to stderr. Exclude >&2 if you don't want it that way.
}

function debug() {
  if [[ -n "$DEBUG" ]]; then
      echo-stderr "$@"
  fi
}

function fail() {
  echo-stderr "$1"
  exit "${2-1}"  ## Return a code specified by $2 or 1 by default.
}

function has() {
  # Check if a command is in $PATH
  which "$@" > /dev/null 2>&1
}

function check-dependencies() {
  debug "Checking dependencies..."
  # shellcheck disable=SC2041
  # Placeholders for whatever programs you really need
  for dep in "$@"
  do
    if ! has "$dep"; then
      fail "Can't find $dep in your $PATH"
    else
      debug "- Found $dep"
    fi
  done
}

function my-name() {
  basename "$0"
}

function usage() {
  echo "Usage: $(my-name) FQDN|IP_ADDRESS"
  echo "Checks the expiration date of  a kubernetes cluster's ca certificate"
}

check-dependencies openssl

if [[ $# != 1 ]]; then
  usage
  exit 13
fi

echo | openssl s_client -connect "$1":6443 2>/dev/null \
  | openssl x509 -noout -enddate \
  | awk -F'=' '{print $2}'
