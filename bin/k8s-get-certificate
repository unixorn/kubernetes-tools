#!/usr/bin/env bash
#
# This base script is MIT licensed so you can base your
# own work on it.
#
# k8s-get-certificate - extract the CA cert from a k8s cluster
#
# Copyright 2025, Joe Block <jpb@unixorn.net>

set -o pipefail
if [[ -n "$DEBUG" ]]; then
  # shellcheck disable=SC2086
  if [[ "$(echo $DEBUG | tr '[:upper:]' '[:lower:]')" == "verbose" ]]; then
    set -x
  fi
fi

function echo-stderr() {
  printf '%s
' "$1" >&2  ## Send message to stderr. Exclude >&2 if you don't want it that way.
}

function debug() {
  if [[ -n "$DEBUG" ]]; then
      echo-stderr "$@"
  fi
}

function fail() {
  echo-stderr "$1"
  exit "${2-1}"  ## Return a code specified by $2 or 1 by default.
}

function has() {
  # Check if a command is in $PATH
  which "$@" > /dev/null 2>&1
}

function check-dependencies() {
  debug "Checking dependencies..."
  # shellcheck disable=SC2041
  # Placeholders for whatever programs you really need
  for dep in "$@"
  do
    if ! has "$dep"; then
      fail "Can't find $dep in your $PATH"
    else
      debug "- Found $dep"
    fi
  done
}

function my-name() {
  basename "$0"
}

function usage() {
  echo "Usage: $(my-name) dumps a kubernetes cluster's ca certificate"
  echo "Args:"
  echo "--dump-to-stdout (overrides --cert-file)"
  echo "--cert-file /path/to/file. Defaults to $CERT_F"
}

check-dependencies kubectl

DUMP_TO_STDOUT=${DUMP_TO_STDOUT:-'false'}
CERT_F=${CERT_F:-'./cluster-api-ca.crt'}

while :
do
  if [[ $# == 0 ]]; then
    break
  fi
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --dump-to-stdout)
      DUMP_TO_STDOUT='true'
      shift
      ;;
    --cert-file)
      shift
      CERT_F="$1"
      shift
      ;;
    -- )
      shift;
      break
      ;;
    *)
      echo-stderr "Unexpected option: $1"
      usage
      fail "Invalid CLI argument: '$1'"
      ;;
  esac
done

ca_crt=$(kubectl get configmap -n kube-system kube-root-ca.crt -o jsonpath='{.data.ca\.crt}')
if [[ "$DUMP_TO_STDOUT" == 'true' ]]; then
  echo "$ca_crt"
else
  echo "$ca_crt" > "$CERT_F"
fi
